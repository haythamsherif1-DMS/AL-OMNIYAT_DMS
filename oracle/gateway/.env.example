# انسخي الملف ده باسم .env (الملف .env ميترفعش على GitHub ومحدش يشوفه غيرك)
ORA_USER=EMMCSYS
ORA_PASSWORD=
ORA_CONNECT=10.176.0.162:1521/dorradeve

# مفتاح سري طويل بين Apps Script والسيرفر ده. اعمليه بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ونفس القيمة تتحط في Script Properties في نسخة DMS باسم ORACLE_GATEWAY_KEY
GATEWAY_KEY=

# البورت (البوابة بتستخدم 8787، فالوثائق على 8788 عشان يشتغلوا مع بعض على نفس الجهاز)
PORT=8788

# ملف شيت الوثائق بعد تنزيله: File > Download > Microsoft Excel (.xlsx)
XLSX_FILE=./DMS_Database.xlsx
